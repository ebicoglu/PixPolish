<Window
    x:Class="PixPolish.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixPolish.UI"
    Title="PixPolish">

    <Grid Padding="24" RowSpacing="16" Background="Transparent" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Folder -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Header="Image folder" PlaceholderText="Pick the folder that contains your images"
                     TextChanged="FolderBox_TextChanged" />
            <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom" Click="Browse_Click" />
        </Grid>

        <!-- Tool selection -->
        <Pivot Grid.Row="1" x:Name="ToolPivot" Height="440">
            <PivotItem Header="Round corners">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <NumberBox x:Name="RadiusBox" Header="Corner radius (% of the shorter side)" Value="3" Minimum="0" Maximum="50"
                               SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <CheckBox x:Name="PostfixCheck" Content="Keep originals: add a &quot;-rounded&quot; postfix to the new files (otherwise the originals are overwritten)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pick images..." Click="PickRoundImages_Click" />
                        <Button Content="Clear" Click="ClearRoundImages_Click" />
                        <TextBlock x:Name="RoundSelectionText" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                    <TextBlock Text="Or drop images (or a folder) anywhere in this window. With no images picked, the whole folder is rounded."
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Clean up unused">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <ComboBox x:Name="MarkdownCombo" Header="Markdown file" Width="360" />
                    <CheckBox x:Name="DryRunCheck" Content="Dry run (only list what would be deleted)" />
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Find missing images">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <ComboBox x:Name="MissingCombo" Header="Markdown file" Width="360" />
                    <TextBlock Text="Lists images written in the markdown that don't exist in the folder." TextWrapping="Wrap" />
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Collage">
                <Grid ColumnSpacing="16" Padding="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <!-- Layout + options -->
                    <ScrollViewer>
                        <StackPanel Spacing="10" Padding="0,0,12,0">
                            <TextBlock Text="Layout" FontWeight="SemiBold" />
                            <GridView x:Name="LayoutGrid" SelectionMode="Single" SelectionChanged="LayoutGrid_Changed" Height="170" />
                            <Slider x:Name="SpacingSlider" Header="Spacing" Minimum="0" Maximum="25" Value="5" ValueChanged="CollageSlider_Changed" />
                            <Slider x:Name="CornerSlider" Header="Rounded corners" Minimum="0" Maximum="30" Value="0" ValueChanged="CollageSlider_Changed" />
                            <ComboBox x:Name="AspectCombo" Header="Shape" HorizontalAlignment="Stretch" SelectionChanged="CollageOption_Changed" />
                            <ComboBox x:Name="BackgroundCombo" Header="Background" HorizontalAlignment="Stretch" SelectionChanged="CollageOption_Changed" />
                            <TextBlock Text="Drag the white lines between photos to resize them. Click a photo, then drag to move it or scroll to zoom it." TextWrapping="Wrap" Opacity="0.7" />
                            <Button Content="Reset photo sizes (lines)" Click="ResetLines_Click" />
                            <Slider x:Name="ZoomSlider" Header="Zoom selected photo" Minimum="1" Maximum="4" StepFrequency="0.05" Value="1"
                                    IsEnabled="False" ValueChanged="ZoomSlider_Changed" />
                            <Button x:Name="ResetPhotoButton" Content="Reset selected photo" IsEnabled="False" Click="ResetPhoto_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview -->
                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                        <!-- Click a photo to select it, drag to move it, scroll to zoom it. -->
                        <local:CursorGrid x:Name="PreviewHost" Background="Transparent" AllowDrop="True" DragOver="Preview_DragOver" Drop="Preview_Drop"
                              PointerPressed="Preview_PointerPressed" PointerMoved="Preview_PointerMoved"
                              PointerReleased="Preview_PointerReleased" PointerCanceled="Preview_PointerReleased"
                              PointerWheelChanged="Preview_PointerWheelChanged" SizeChanged="PreviewHost_SizeChanged">
                            <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="DividerLine" Visibility="Collapsed" Fill="{ThemeResource SystemAccentColor}" Opacity="0.85" RadiusX="2" RadiusY="2" />
                                <Rectangle x:Name="SelectionBox" Visibility="Collapsed" StrokeThickness="3"
                                           Stroke="{ThemeResource SystemAccentColor}" />
                            </Canvas>
                        </local:CursorGrid>
                    </Border>

                    <!-- Photos -->
                    <Grid Grid.Column="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PhotosHeader" Text="Photos (drag to reorder)" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ListView Grid.Row="1" x:Name="PhotoList" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                  SelectionMode="Single" DragItemsStarting="PhotoList_DragItemsStarting">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="54" CornerRadius="4">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Spacing="6">
                            <Button Content="Choose photos..." HorizontalAlignment="Stretch" Click="ChoosePhotos_Click" />
                            <Button Content="Remove selected" HorizontalAlignment="Stretch" Click="RemovePhoto_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <Button Grid.Row="2" x:Name="RunButton" Content="Run" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />

        <TextBox Grid.Row="3" x:Name="LogBox" Header="Log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="160" />
    </Grid>
</Window>
